{
    "name": "lucajackal85/pii-sanitizer-php",
    "description": "Monolog processor and Unix-socket client that scrub PII and secrets via the local PII Sanitizer Engine.",
    "homepage": "https://github.com/lucajackal85/pii-sanitizer-php",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Luca Giacalone",
            "homepage": "https://github.com/lucajackal85"
        }
    ],
    "support": {
        "issues": "https://github.com/lucajackal85/pii-sanitizer-php/issues",
        "source": "https://github.com/lucajackal85/pii-sanitizer-php"
    },
    "keywords": [
        "monolog",
        "pii",
        "gdpr",
        "logging",
        "redaction"
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "OpenPii\\MonologSanitizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenPii\\MonologSanitizer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run",
        "rector-fix": "rector process",
        "check": [
            "@cs",
            "@rector",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
