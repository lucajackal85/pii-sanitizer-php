{
    "name": "lucajackal85/pii-sanitizer-php",
    "description": "Monolog processor, Laravel tap and Symfony bundle that scrub PII and secrets via the local PII Sanitizer Engine (Unix socket).",
    "homepage": "https://github.com/lucajackal85/pii-sanitizer-php",
    "type": "library",
    "keywords": ["monolog", "pii", "gdpr", "logging", "redaction", "symfony", "laravel"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/config": "^6.4 || ^7.0"
    },
    "suggest": {
        "symfony/http-kernel": "To use the Symfony bundle (PiiSanitizerBundle)",
        "illuminate/log": "To use the Laravel logging tap (PiiSanitizerTap)"
    },
    "autoload": {
        "psr-4": {
            "OpenPii\\MonologSanitizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenPii\\MonologSanitizer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
